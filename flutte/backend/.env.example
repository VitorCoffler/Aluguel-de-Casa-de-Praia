# Copie este arquivo para .env. Não publique o .env.
PORT=4000
HOST=127.0.0.1
DATA_DIR=./data
ALLOWED_ORIGINS=http://localhost:5300
NODE_ENV=development
# Apenas desenvolvimento: o código de recuperação aparece no terminal da API.
DEV_RESET_LOG=true
# Produção: serviço HTTPS próprio que recebe {email,token,expires_in_minutes}
# e envia o código para o e-mail informado. Não há provedor contratado neste pacote.
# RESET_WEBHOOK_URL=https://seu-servico-de-email.example/reset
# RESET_WEBHOOK_SECRET=defina-um-segredo-do-seu-servico
